# ---------------------------------------------------------------------------
# Desi Fighter — environment example.
# Copy to `.env` for local overrides. NEVER commit real secrets.
# The MVP has no database and requires no API keys or paid services.
# ---------------------------------------------------------------------------

# --- Server (apps/server) ---
# HTTP + WebSocket port for the Colyseus server.
SERVER_PORT=2567
# Server version reported by the /healthz endpoint.
SERVER_VERSION=0.1.0

# --- Web (apps/web) ---
# Version string shown in the client build.
VITE_APP_VERSION=0.1.0
# Colyseus WebSocket endpoint used by the browser client (used from Phase 4).
VITE_SERVER_URL=ws://localhost:2567
